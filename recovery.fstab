# recovery.fstab — device/motorola/penang
#
# TWRP Recovery Filesystem Table
# Corrections applied:
#   1. fsflags=ro added to all read-only logical partitions (system, system_ext, 
#      product, vendor, odm) — erofs is read-only by nature
#   2. Both ext4 and erofs variants for dynamic partitions (system, system_ext, 
#      product, vendor, odm) — device may have either filesystem
#   3. FBE/metadata encryption flags for /data using kernel defaults
#   4. F2FS filesystem for /data (verify with 'blkid /dev/block/sde26' if issues occur)
#   5. SD Card mount at /dev/block/mmcblk1p1 (external microSD)
#

/system         ext4      system                                     flags=display=system;logical;slotselect;fsflags=ro
/system         erofs     system                                     flags=display=system;logical;slotselect;fsflags=ro
/system_ext     ext4      system_ext                                 flags=display=system_ext;logical;slotselect;fsflags=ro
/system_ext     erofs     system_ext                                 flags=display=system_ext;logical;slotselect;fsflags=ro
/product        ext4      product                                    flags=display=product;logical;slotselect;fsflags=ro
/product        erofs     product                                    flags=display=product;logical;slotselect;fsflags=ro
/vendor         ext4      vendor                                     flags=display=vendor;logical;slotselect;fsflags=ro
/vendor         erofs     vendor                                     flags=display=vendor;logical;slotselect;fsflags=ro
/odm            ext4      odm                                        flags=display=odm;logical;slotselect;fsflags=ro
/odm            erofs     odm                                        flags=display=odm;logical;slotselect;fsflags=ro
/metadata       ext4      /dev/block/bootdevice/by-name/metadata     flags=display=metadata
/data           f2fs      /dev/block/bootdevice/by-name/userdata     flags=display=data;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0;metadata_encryption=aes-256-xts:wrappedkey_v0
/sdcard         vfat      /dev/block/mmcblk1p1                       flags=display=sdcard
/boot           emmc      /dev/block/bootdevice/by-name/boot         flags=display=boot
/misc           emmc      /dev/block/bootdevice/by-name/misc         flags=display=misc
